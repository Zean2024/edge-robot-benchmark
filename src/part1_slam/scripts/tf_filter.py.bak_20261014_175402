#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from tf2_msgs.msg import TFMessage

class TfFilter(Node):
    def __init__(self):
        super().__init__('tf_filter')
        # Subscribe to the remapped /tf_bag topic
        self.sub = self.create_subscription(TFMessage, '/tf_bag', self.callback, 10)
        # Publish to the standard /tf topic
        self.pub = self.create_publisher(TFMessage, '/tf', 10)
        self.get_logger().info('TF Filter running: dropping odom_combined -> base_footprint from /tf_bag')

    def callback(self, msg):
        filtered_transforms = []
        for transform in msg.transforms:
            # Drop the conflicting odom_combined -> base_footprint transform
            if (transform.header.frame_id == 'odom_combined' and
                transform.child_frame_id == 'base_footprint'):
                continue
            filtered_transforms.append(transform)

        # Republish only the static transforms
        if filtered_transforms:
            new_msg = TFMessage()
            new_msg.transforms = filtered_transforms
            self.pub.publish(new_msg)

def main():
    rclpy.init()
    node = TfFilter()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main()
