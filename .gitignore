# 1. Datasets
datasets/raw/*
datasets/processed/*
!datasets/raw/.gitkeep
!datasets/processed/.gitkeep
!datasets/processed/README.md

# 2. Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/

# 3. Backup and temporary files
*.bak
*.backup
*.tmp
*odom_only_backup*
*scan_topic_*
*scan_gate_*
*scan_routing_*
*safe_shutdown_*

# 4. Generated run artifacts
results/part1_slam/runs/*
!results/part1_slam/runs/.gitkeep

results/part1_slam/tf_checks/*
!results/part1_slam/tf_checks/.gitkeep

results/part1_slam/tf_validation/*
!results/part1_slam/tf_validation/.gitkeep
!results/part1_slam/tf_validation/*.md
!results/part1_slam/tf_validation/*.py

results/part1_slam/evaluation/per_run/*
!results/part1_slam/evaluation/per_run/.gitkeep

# 5. Logs, ROS bags and binary artifacts
*.log
*.bag
*.db3
*.mcap
*.pbstream
*.tum